<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Garanties 100% Native AOT & Trimming -->
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!-- Qualité & Documentation NuGet -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>Flash2Fa</PackageId>
    <Version>1.0.1</Version>
    <Authors>Jetonpeche</Authors>
    <Description>High-performance, zero-dependency, zero-allocation, 100% Native AOT 2FA library for .NET 10+ (TOTP RFC 6238, SVG/PNG QR codes, and SHA-256 recovery codes).</Description>
    <PackageTags>2fa;totp;qrcode;svg;png;aot;nativeaot;zero-allocation;security;authentication</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <PackageProjectUrl>https://github.com/JetonpecheCorp/Flash2Fa</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JetonpecheCorp/Flash2Fa.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>

    <PackageIcon>logoFlash2fa.png</PackageIcon>
    <Copyright>Copyright © 2026 Jetonpeche. All rights reserved.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\assets\logoFlash2fa.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\README.en.md" Pack="true" PackagePath="\" />
    <None Include="docs\Flash2Fa.en.xml" Pack="true" PackagePath="lib\net10.0\en\Flash2Fa.xml" />
  </ItemGroup>

  <!-- Exposition des internes uniquement pour les tests unitaires -->
  <ItemGroup>
    <InternalsVisibleTo Include="Flash2Fa.Tests" />
  </ItemGroup>

</Project>
